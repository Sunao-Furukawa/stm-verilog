# B, then B/J/JAL
#
# Header start
#
USING   14,300
USING_I 14,300
EQU 300
main:
X   0,0,0
O   14,0,%300
B   L1
#
EQU 3D0
DEAD:
DD000000
EQU 3F0
SUCCESS:
DF000000
#
# Header end
#
EQU 400
#N = 3 (# of cases)
#BLK = 0x40 (16 insns)
L1:
O   1,0,%0
# N*BLK
O   4,0,%C0
L2:
#LL0
JAL 5,1(500)
L3:
C   1,2
BNE DEAD
# BLK
A   1,1,%40
C   1,4
BL  L2
B   SUCCESS
#
# i = 0
EQU 500
LL0:
# BLK*i
O   2,0,%0
B   TT0
BNE DEAD
BE DEAD
